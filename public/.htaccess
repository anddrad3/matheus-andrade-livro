# Cache do navegador: sem isto, cada imagem era revalidada com o servidor a cada visita.
<IfModule mod_headers.c>
  # arquivos do build com hash no nome: nunca mudam
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Else>
    # imagens, texturas, gravuras e música: uma semana
    <FilesMatch "\.(webp|png|jpe?g|svg|mp3|woff2?)$">
      Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # a página sempre confere se há versão nova
    <FilesMatch "\.html?$">
      Header set Cache-Control "no-cache"
    </FilesMatch>
  </Else>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>
