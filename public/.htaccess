# Cache do navegador: sem isto, cada imagem era revalidada com o servidor a cada visita.
# Imagens e músicas têm nome fixo: ao trocar uma, troque também o nome do arquivo.
<IfModule mod_headers.c>
  # imagens, texturas, gravuras e música: um ano
  <FilesMatch "\.(webp|png|jpe?g|svg|mp3|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # arquivos do build (com hash no nome): nunca mudam
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # a página sempre confere se há versão nova
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # segurança (a CSP de scripts, com hashes, vai numa <meta> gerada no build)
  # HTTPS sempre (HSTS), sem ser embutido em sites de terceiros (clickjacking),
  # janela isolada de pop-ups de outras origens (COOP) e tipos de arquivo respeitados
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>
